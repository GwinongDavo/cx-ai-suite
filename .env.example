# Pick ONE provider. With no key at all, every app runs in demo mode.

# Option A: Google Gemini (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Option B: OpenAI
# OPENAI_API_KEY=

# Option C: Azure OpenAI (deployment names you created in Azure AI Foundry)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-10-21
# CX_CHAT_MODEL=gpt-4.1-mini
# CX_EMBED_MODEL=text-embedding-3-small

# Optional
# CX_LLM_PROVIDER=gemini          # force a provider (or "mock")
# CX_HANDOFF_THRESHOLD=0.30       # retrieval confidence below this hands off to a human
# CX_REPO_URL=https://github.com/<you>/cx-ai-suite
# CX_PORTFOLIO_URL=https://gwinongdavo.vercel.app
